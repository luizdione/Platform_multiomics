# ômica — configuração ÚNICA (copie para .env e ajuste).
# Anti-lição nº 1 da auditoria: nenhuma outra fonte de config é permitida —
# todo caminho passa por omica/config.py, que lê ambiente > .env > defaults.

# Porta da UI/API no host
OMICA_PORT=8710

# Dados pesados da plataforma (host Windows). Nos containers o compose fixa /data/omica.
OMICA_DATA=E:\data\omica

# Raiz dos dados pesados legados (VCFs 1000 Bull etc.) — montada como /data nos containers
GENOME_DATA=E:\data

# Orçamento de RAM p/ soma dos jobs ativos (GB) e teto de uso do sistema (%)
# Regra da máquina de 32 GB: nunca lançar job acima de 80% de uso total.
OMICA_MAX_RAM_GB=24
OMICA_RAM_MAX_PCT=80

# Biblioteca de skills de bioinformática (montada read-only como /skills)
SKILLS_DIR=C:\Users\luizd\.claude\skills_bioinfo

# Fila de jobs. Vazio = fallback de thread local (testes/uso sem Docker).
# No docker compose os containers já recebem redis://omica-redis:6379/0.
OMICA_REDIS_URL=

# Idioma padrão da UI: pt | en
OMICA_LANG=pt

# Professor Ômico — motor LOCAL (Ollama, o mesmo do LILO). O LLM só propõe
# planos do catálogo; nada roda sem clique. Fora do ar = aba continua útil.
# Dentro do container o default é http://host.docker.internal:11434.
OMICA_OLLAMA_URL=
OMICA_OLLAMA_MODEL=qwen3:14b

# Plugin Bioinfo (roteia as mesmas 815 skills no assistente de código). Só no HOST:
# é de onde `python -m omica reindex` copia o glossário de busca PT→EN para data/.
# Nos containers o plugin não é montado e vale a cópia já versionada.
BIOINFO_PLUGIN_DIR=C:\GitHub\Plugin_Skills\plugins\bioinfo

# API JSON v1 (/api/v1) para orquestradores externos (n8n). Vazio = API DESLIGADA
# (responde 503: falha fechada). Gere um valor aleatório SÓ no seu .env, ex.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# e cadastre o mesmo valor no n8n como credencial Header Auth ("omica Bearer").
# NUNCA ponha o valor aqui, no compose `environment:` (aparece no `docker inspect`)
# nem em JSON de workflow.
OMICA_API_TOKEN=

# Onde o omica-web escuta no host. Padrão: só a própria máquina (127.0.0.1).
# Para aula pela rede local use 0.0.0.0 CONSCIENTEMENTE: as páginas HTML ficam
# abertas na LAN (a API v1 continua exigindo o token).
OMICA_BIND=127.0.0.1

# Interruptor da GPU do autor (LILO/ollama-delegate). No container ele chega montado
# somente leitura em /gpu_switch. Ausente = GPU tratada como NÃO liberada.
OLLAMA_DELEGATE_DIR=C:/Users/luizd/.ollama_delegate
